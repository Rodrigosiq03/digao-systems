# Cloud Gaming backend host mode (Sunshine provider dev v1)

PORT=8090
STREAM_PROVIDER=sunshine
FRAME_RATE=60
STREAM_SOCKET_PATH=/tmp/digao-cloud-gaming/stream.sock

AUTH_MODE=oidc
OIDC_ISSUER_URL=https://kc-dev.rodrigodsiqueira.dev.br:8443/realms/digao-oauth-dev
OIDC_CLIENT_ID=digao-cloud-gaming

MAX_CONCURRENT_SESSIONS=1
LAUNCH_MODE=exec
SESSION_SHELL=/bin/bash

GAME_CATALOG_FILE=/data/apps/deploy/cloud-gaming/host/catalog.dev-v1.json
