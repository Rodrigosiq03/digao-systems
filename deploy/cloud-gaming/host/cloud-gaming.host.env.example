# Cloud Gaming backend host mode (Sunshine provider dev v1)

PORT=8090
STREAM_PROVIDER=sunshine
FRAME_RATE=60
STREAM_SOCKET_PATH=/tmp/digao-cloud-gaming/stream.sock

AUTH_MODE=proxy
AUTH_PROXY_USER_HEADER=X-Forwarded-User
AUTH_PROXY_EMAIL_HEADER=X-Forwarded-Email

MAX_CONCURRENT_SESSIONS=1
LAUNCH_MODE=exec
SESSION_SHELL=/bin/bash
SESSION_AUTO_END_ON_PROCESS_EXIT=false
GAME_LAUNCH_PREFIX="/data/apps/deploy/cloud-gaming/host/launch-game.sh --command {command} --game-id {game_id}"

GAME_CATALOG_FILE=/data/apps/deploy/cloud-gaming/host/catalog.dev-v1.json
